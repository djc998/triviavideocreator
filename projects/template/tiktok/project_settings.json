{
  "questions_file": "../questions.json",
  "background": {
    "color": "#060CE9",
    "opacity": 1.0,
    "image": "backgrounds/OneDirection-Background-9-16.png"
  },
  "text": {
    "font": "Phosphate-Solid",
    "size": {
      "question": 100,
      "answer": 130,
      "timer": 100
    },
    "color": "#FFFFFF",
    "shadow": {
      "enabled": true,
      "color": "#000000",
      "offset": {
        "x": 5,
        "y": 5
      }
    },
    "outline": {
      "enabled": true,
      "color": "#000000",
      "thickness": 2
    },
    "question": {
      "position": {
        "x": "center",
        "y": "700",
        "padding": 20
      },
      "dimensions": {
        "width": 900,
        "height": null
      }
    },
    "answer": {
      "position": {
        "x": "center",
        "y": "center",
        "padding": 50
      },
      "dimensions": {
        "width": 800,
        "height": null
      }
    },
    "alignment": "center",
    "wrap_width": 20,
    "overlays": [
      {
        "content": "Follow Us",
        "font": "Phosphate-Solid",
        "size": 40,
        "color": "#FFFFFF",
        "position": {
          "x": "right",
          "y": "bottom",
          "padding": 20
        },
        "dimensions": {
          "width": 300,
          "height": null
        },
        "timing": {
          "start": 0,
          "duration": "full",
          "fade": {
            "enabled": true,
            "duration": 0.3
          }
        }
      }
    ]
  },
  "timing": {
    "question_duration": 5,
    "answer_duration": 2
  },
  "transitions": {
    "type": "fade",
    "duration": 0.3,
    "crossfade_duration": 0.2
  },
  "video": {
    "width": 1080,
    "height": 1920,
    "fps": 30,
    "codec": "libx264",
    "preset": "ultrafast"
  },
  "timer": {
    "shape": "circle",
    "circle": {
      "size": 150,
      "color": "#FFFFFF",
      "position": {
        "x": "right",
        "y": 200,
        "padding": 100
      }
    },
    "square": {
      "size": 140,
      "color": "#FFFFFF",
      "position": {
        "x": "right",
        "y": 30,
        "padding": 30
      }
    },
    "text": {
      "color": "#000000"
    },
    "sound": {
      "enabled": false,
      "file": "/sounds/tick.mp3",
      "volume": 3.0
    }
  },
  "audio": {
    "file": "music/gameshow-brazz-loop-3min.mp3",
    "volume": 1.0,
    "loop": true
  }
} 